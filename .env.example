# Secret used to sign session cookies, at least 32 characters (the app won't start without it)
SESSION_SECRET=
# Set to true to send the session cookie only over HTTPS (leave false for localhost)
COOKIE_SECURE=false
# Password for the seeded ops (back office) users
SEED_OPS_PASSWORD=
# Password for the seeded customer users
SEED_CUSTOMER_PASSWORD=
# Shared key for the read-only /mcp endpoint, at least 32 characters; /mcp is off when unset.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
MCP_API_KEY=
